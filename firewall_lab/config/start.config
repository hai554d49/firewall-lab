    GLOBAL_SETTINGS
    LAB_MASTER_SEED firewall_lab_student_master_seed
NETWORK WAN_NET
     MASK 192.168.10.0/24
     GATEWAY 192.168.10.1
NETWORK DMZ_NET
     MASK 192.168.20.0/24
     GATEWAY 192.168.20.1
NETWORK LAN_NET
     MASK 192.168.30.0/24
     GATEWAY 192.168.30.1
CONTAINER attacker
     USER ubuntu
     X11 YES
     TERMINAL_GROUP ATTACK
     WAN_NET 192.168.10.10
     LAB_GATEWAY 192.168.10.254
CONTAINER webserver
     USER ubuntu
     X11 YES
     TERMINAL_GROUP LOCAL
     DMZ_NET 192.168.20.10
     LAB_GATEWAY 192.168.20.254
CONTAINER dnsserver
     USER ubuntu
     X11 YES
     TERMINAL_GROUP LOCAL
     DMZ_NET 192.168.20.20
     LAB_GATEWAY 192.168.20.254
CONTAINER client
     USER tom
     X11 YES
     TERMINALS 2
     TERMINAL_GROUP ATTACK
     LAN_NET 192.168.30.10
     LAB_GATEWAY 192.168.30.254
CONTAINER admin
     USER admin
     X11 YES
     TERMINAL_GROUP LOCAL
     LAN_NET 192.168.30.20
     LAB_GATEWAY 192.168.30.254
CONTAINER firewall
     USER ubuntu
     X11 YES
     TERMINAL_GROUP LOCAL
     WAN_NET 192.168.10.254
     DMZ_NET 192.168.20.254
     LAN_NET 192.168.30.254
